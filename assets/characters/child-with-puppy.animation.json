{
  "schema_version": 2,
  "character": "child-with-puppy",
  "facing": "right",
  "mirror_for_left": true,
  "suggested_visible_height_px": 52,
  "crop_transparent_padding": true,
  "anchor": "bottom-center",
  "states": {
    "idle": {
      "when": "grounded and horizontal speed near zero",
      "frames": ["child-with-puppy-idle.png"]
    },
    "run": {
      "when": "grounded and moving horizontally",
      "frames": ["child-with-puppy-run-1.png", "child-with-puppy-idle.png", "child-with-puppy-run-2.png", "child-with-puppy-idle.png"],
      "distance_per_frame_px": 22
    },
    "walk": {
      "frames": ["child-with-puppy-run-1.png", "child-with-puppy-idle.png", "child-with-puppy-run-2.png", "child-with-puppy-idle.png"]
    },
    "land": {
      "frames": ["child-with-puppy-land.png"],
      "height_px": 46,
      "duration_ticks": 8
    },
    "brake": {
      "frames": ["child-with-puppy-brake.png"],
      "height_px": 50
    },
    "apex": {
      "frames": ["child-with-puppy-jump.png"],
      "height_px": 50
    },
    "hurt": {
      "frames": ["child-with-puppy-fall.png"]
    },
    "jump": {
      "when": "airborne and rising",
      "frames": ["child-with-puppy-jump.png"]
    },
    "fall": {
      "when": "airborne and falling",
      "frames": ["child-with-puppy-fall.png"]
    }
  }
}
